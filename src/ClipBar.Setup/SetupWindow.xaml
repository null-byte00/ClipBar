<ui:FluentWindow x:Class="ClipBar.Setup.SetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Установка ClipBar" Width="640" Height="660" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                 FontFamily="{StaticResource Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Установка ClipBar" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="32,4,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="56" Height="56" CornerRadius="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF1293A" Offset="0" />
                            <GradientStop Color="#FFB50D1B" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Ellipse Width="22" Height="22" Stroke="White" StrokeThickness="4" />
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ClipBar" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Text="1.0.0" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Bottom" Margin="8,0,0,5" />
                    </StackPanel>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}">
                        <Run Text="Запись экрана с мгновенным повтором · by" />
                        <Run Text="@lumaseller" Foreground="#FFFF6B7A" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="OptionsScroll" Grid.Row="1" Margin="0,20,0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OptionsPage" Margin="0,0,8,0">
                <TextBlock Text="Папка установки" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="PathBox" IsReadOnly="True" />
                    <ui:Button Grid.Column="1" Content="Изменить…" Margin="8,0,0,0" Click="Browse_Click" />
                </Grid>
                <CheckBox x:Name="DesktopCheck" Content="Ярлык на рабочем столе" IsChecked="True" Margin="0,18,0,0" />
                <CheckBox x:Name="AutostartCheck" Content="Запускать вместе с Windows (откат пишется с самого старта)" IsChecked="True" Margin="0,6,0,0" />
                <CheckBox x:Name="LaunchCheck" Content="Запустить ClipBar после установки" IsChecked="True" Margin="0,6,0,0" />
                <TextBlock x:Name="UpdateNote" Visibility="Collapsed" Margin="0,14,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap" />

                <TextBlock Text="Проверка системы" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,6" />
                <ItemsControl x:Name="CheckList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0" Fill="{Binding Dot}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="3" Content="Доставить" Margin="8,0,0,0" Padding="10,3" FontSize="12"
                                           Visibility="{Binding FixVisibility}" Click="Fix_Click" Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="OthersPanel" Visibility="Collapsed">
                    <TextBlock Text="Другие программы для скриншотов и записи" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,2" />
                    <TextBlock Text="Отметь, что удалить, чтобы PrintScreen, Win+Shift+S и Alt+Z работали только в ClipBar. Без галочки ничего не удаляется."
                               FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.8" />
                    <ItemsControl x:Name="OthersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Remove, Mode=TwoWay}" Margin="0,2">
                                    <TextBlock>
                                        <Run Text="{Binding Tool.Name, Mode=OneWay}" />
                                        <Run Text="{Binding Tool.Note, Mode=OneWay, StringFormat=' — {0}'}" Foreground="{StaticResource TextSecondary}" />
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="ProgressPage" Grid.Row="1" Margin="0,48,0,0" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Text="Подготовка…" FontSize="14" />
                <ProgressBar x:Name="Progress" Height="6" Margin="0,14,0,0" Maximum="1" Foreground="{StaticResource Accent}" />
            </StackPanel>

            <StackPanel x:Name="DonePage" Grid.Row="1" Margin="0,24,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="24" Foreground="#FF30D158" />
                    <TextBlock Text="ClipBar установлен" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="DoneNote" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="16,12" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Alt+F10" FontWeight="SemiBold" Margin="0,2,20,2" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="сохранить мгновенный повтор" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="Alt+F9" FontWeight="SemiBold" Margin="0,2,20,2" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="начать / остановить запись" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="Alt+Z" FontWeight="SemiBold" Margin="0,2,20,2" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="оверлей: откат, галерея, редактор" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                        <TextBlock Grid.Row="3" Text="Win+Shift+S" FontWeight="SemiBold" Margin="0,2,20,2" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="скриншот области" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                        <TextBlock Grid.Row="4" Text="Alt+F1" FontWeight="SemiBold" Margin="0,2,20,2" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="скриншот всего экрана" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" MinWidth="110" />
                <ui:Button x:Name="PrimaryButton" Content="Установить" Appearance="Danger" Click="Primary_Click" MinWidth="130" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
