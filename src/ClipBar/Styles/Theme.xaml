<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="CB.Color.OverlayDim">#73000000</Color>
    <Color x:Key="CB.Color.Widget">#F0202020</Color>
    <Color x:Key="CB.Color.WidgetBorder">#26FFFFFF</Color>
    <Color x:Key="CB.Color.Card">#FF2B2B2B</Color>
    <Color x:Key="CB.Color.CardHover">#FF323232</Color>
    <Color x:Key="CB.Color.Control">#FF3A3A3A</Color>
    <Color x:Key="CB.Color.ControlHover">#FF454545</Color>
    <Color x:Key="CB.Color.ControlPressed">#FF2F2F2F</Color>
    <Color x:Key="CB.Color.Divider">#1FFFFFFF</Color>
    <Color x:Key="CB.Color.TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="CB.Color.TextSecondary">#FFC5C5C5</Color>
    <Color x:Key="CB.Color.TextTertiary">#FF8A8A8A</Color>
    <Color x:Key="CB.Color.Accent">#FF4CC2FF</Color>
    <Color x:Key="CB.Color.AccentDark">#FF0078D4</Color>
    <Color x:Key="CB.Color.Record">#FFE81123</Color>
    <Color x:Key="CB.Color.RecordHover">#FFF1293A</Color>
    <Color x:Key="CB.Color.Success">#FF6CCB5F</Color>
    <Color x:Key="CB.Color.Warning">#FFFCE100</Color>
    <Color x:Key="CB.Color.Error">#FFFF99A4</Color>

    <SolidColorBrush x:Key="CB.OverlayDim" Color="{StaticResource CB.Color.OverlayDim}" />
    <SolidColorBrush x:Key="CB.Widget" Color="{StaticResource CB.Color.Widget}" />
    <SolidColorBrush x:Key="CB.WidgetBorder" Color="{StaticResource CB.Color.WidgetBorder}" />
    <SolidColorBrush x:Key="CB.Card" Color="{StaticResource CB.Color.Card}" />
    <SolidColorBrush x:Key="CB.CardHover" Color="{StaticResource CB.Color.CardHover}" />
    <SolidColorBrush x:Key="CB.Control" Color="{StaticResource CB.Color.Control}" />
    <SolidColorBrush x:Key="CB.ControlHover" Color="{StaticResource CB.Color.ControlHover}" />
    <SolidColorBrush x:Key="CB.ControlPressed" Color="{StaticResource CB.Color.ControlPressed}" />
    <SolidColorBrush x:Key="CB.Divider" Color="{StaticResource CB.Color.Divider}" />
    <SolidColorBrush x:Key="CB.TextPrimary" Color="{StaticResource CB.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CB.TextSecondary" Color="{StaticResource CB.Color.TextSecondary}" />
    <SolidColorBrush x:Key="CB.TextTertiary" Color="{StaticResource CB.Color.TextTertiary}" />
    <SolidColorBrush x:Key="CB.Accent" Color="{StaticResource CB.Color.Accent}" />
    <SolidColorBrush x:Key="CB.AccentDark" Color="{StaticResource CB.Color.AccentDark}" />
    <SolidColorBrush x:Key="CB.Record" Color="{StaticResource CB.Color.Record}" />
    <SolidColorBrush x:Key="CB.RecordHover" Color="{StaticResource CB.Color.RecordHover}" />
    <SolidColorBrush x:Key="CB.Success" Color="{StaticResource CB.Color.Success}" />
    <SolidColorBrush x:Key="CB.Warning" Color="{StaticResource CB.Color.Warning}" />
    <SolidColorBrush x:Key="CB.Error" Color="{StaticResource CB.Color.Error}" />

    <CornerRadius x:Key="CB.Radius.Widget">8</CornerRadius>
    <CornerRadius x:Key="CB.Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="CB.Radius.Small">4</CornerRadius>
    <FontFamily x:Key="CB.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="CB.FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>

    <DropShadowEffect x:Key="CB.Shadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />

    <Style x:Key="CB.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CB.Font}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CB.TextPrimary}" />
    </Style>
    <Style x:Key="CB.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CB.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource CB.TextPrimary}" />
    </Style>
    <Style x:Key="CB.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CB.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource CB.TextSecondary}" />
    </Style>
    <Style x:Key="CB.Text.Big" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CB.FontDisplay}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CB.TextPrimary}" />
    </Style>

    <Style x:Key="CB.WidgetPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CB.Widget}" />
        <Setter Property="BorderBrush" Value="{StaticResource CB.WidgetBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CB.Radius.Widget}" />
        <Setter Property="Effect" Value="{StaticResource CB.Shadow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CB.CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CB.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource CB.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CB.Radius.Widget}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="CB.SquareButton" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Foreground" Value="{StaticResource CB.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource CB.Control}" />
        <Setter Property="BorderBrush" Value="{StaticResource CB.WidgetBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource CB.Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CB.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CB.ControlPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CB.RecordButton" TargetType="Button" BasedOn="{StaticResource CB.SquareButton}">
        <Setter Property="Background" Value="{StaticResource CB.Record}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CB.Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CB.RecordHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CB.IconButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource CB.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CB.Radius.Small}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CB.ControlHover}" />
                            <Setter Property="Foreground" Value="{StaticResource CB.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CB.ControlPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CB.RowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CB.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CB.Radius.Small}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CB.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CB.ControlPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
