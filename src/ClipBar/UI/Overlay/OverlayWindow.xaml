<Window x:Class="ClipBar.UI.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ClipBar — оверлей"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="{StaticResource CB.Font}" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI/Overlay/OverlayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="Gfe.Panel" Color="#F2141414" />
            <SolidColorBrush x:Key="Gfe.Tile" Color="#FF222222" />
            <SolidColorBrush x:Key="Gfe.TileHover" Color="#FF2E2E2E" />
            <SolidColorBrush x:Key="Gfe.TilePressed" Color="#FF383838" />
            <SolidColorBrush x:Key="Gfe.Line" Color="#1FFFFFFF" />

            <Style x:Key="Gfe.TileButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource CB.TextPrimary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Height" Value="112" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource Gfe.Tile}" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{StaticResource Gfe.Line}" Padding="14,12">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gfe.TileHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gfe.TilePressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Gfe.Chip" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource CB.TextPrimary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource Gfe.Tile}" CornerRadius="15" BorderThickness="1"
                                    BorderBrush="{StaticResource Gfe.Line}" Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gfe.TileHover}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CB.Accent}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gfe.TilePressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Gfe.SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource CB.TextTertiary}" />
                <Setter Property="Margin" Value="2,18,0,8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}" Opacity="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="392" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Dim" Grid.ColumnSpan="2" Background="#99000000" MouseLeftButtonDown="Dim_MouseLeftButtonDown" />

        <Border x:Name="SidePanel" Grid.Column="0" Background="{StaticResource Gfe.Panel}"
                BorderBrush="{StaticResource Gfe.Line}" BorderThickness="0,0,1,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelSlide" X="-40" />
            </Border.RenderTransform>
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="20,18,14,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFF1293A" Offset="0" />
                                    <GradientStop Color="#FFB50D1B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="2.5" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ClipBar" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource CB.TextPrimary}" />
                            <TextBlock x:Name="ClockText" Text="00:00" FontSize="11" Foreground="{StaticResource CB.TextTertiary}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="RecIndicator" Background="#33E81123" CornerRadius="11" Padding="9,3" Margin="0,0,6,0"
                                VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Идёт запись">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource CB.Record}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RecIndicatorText" Text="00:00" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource CB.TextPrimary}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource Ov.BarButton}" ToolTip="Настройки ClipBar" Click="Settings_Click">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                        </Button>
                        <Button Style="{StaticResource Ov.BarButton}" ToolTip="Закрыть (Esc)" Click="Close_Click">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" Style="{StaticResource CB.Text.Caption}"
                           Foreground="{StaticResource CB.TextTertiary}" Margin="20,8,20,14" TextWrapping="Wrap"
                           Text="Esc — закрыть" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="20,0,20,8" Focusable="False">
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="-4,10,-4,0">
                            <Button x:Name="ReplayTile" Style="{StaticResource Gfe.TileButton}" Margin="4" Click="ReplayTile_Click">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="History24" FontSize="26" Foreground="{StaticResource CB.TextPrimary}" HorizontalAlignment="Left" />
                                    <TextBlock Text="Мгновенный повтор" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ReplayTileStatus" Text="Выкл" FontSize="11" Foreground="{StaticResource CB.TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RecordTile" Style="{StaticResource Gfe.TileButton}" Margin="4" Click="RecordTile_Click">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Left" Height="26">
                                        <ui:SymbolIcon x:Name="RecordTileIcon" Symbol="Record24" FontSize="26" Foreground="{StaticResource CB.Record}" />
                                    </Grid>
                                    <TextBlock x:Name="RecordTileTitle" Text="Запись" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBlock x:Name="RecordTileStatus" Text="Alt+F9" FontSize="11" Foreground="{StaticResource CB.TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ScreenshotTile" Style="{StaticResource Gfe.TileButton}" Margin="4" Click="ScreenshotTile_Click">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Camera24" FontSize="26" Foreground="{StaticResource CB.TextPrimary}" HorizontalAlignment="Left" />
                                    <TextBlock Text="Скриншот" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBlock x:Name="ScreenshotTileStatus" Text="Alt+F1" FontSize="11" Foreground="{StaticResource CB.TextSecondary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="GalleryTile" Style="{StaticResource Gfe.TileButton}" Margin="4" Click="GalleryTile_Click">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="26" Foreground="{StaticResource CB.TextPrimary}" HorizontalAlignment="Left" />
                                    <TextBlock Text="Галерея и редактор" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Смотреть, обрезать, экспорт" FontSize="11" Foreground="{StaticResource CB.TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="МГНОВЕННЫЙ ПОВТОР" Style="{StaticResource Gfe.SectionTitle}" />
                        <Border Background="{StaticResource Gfe.Tile}" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Gfe.Line}" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ReplayStateText" Text="Выключен" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CB.TextPrimary}" />
                                        <TextBlock x:Name="ReplayDetailText" Text="" FontSize="11" Foreground="{StaticResource CB.TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="ReplaySwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ReplaySwitch_Click" />
                                </Grid>
                                <Border Height="4" CornerRadius="2" Background="#1AFFFFFF" Margin="0,10,0,0">
                                    <Border x:Name="ReplayFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource CB.Accent}" />
                                </Border>
                                <TextBlock Text="Сохранить последние:" FontSize="11" Foreground="{StaticResource CB.TextTertiary}" Margin="0,12,0,6" />
                                <UniformGrid x:Name="ReplayChips" Rows="1" Margin="-3,0">
                                    <Button Style="{StaticResource Gfe.Chip}" Margin="3,0" Tag="30" Click="SaveChip_Click" Content="30 сек" />
                                    <Button Style="{StaticResource Gfe.Chip}" Margin="3,0" Tag="60" Click="SaveChip_Click" Content="1 мин" />
                                    <Button Style="{StaticResource Gfe.Chip}" Margin="3,0" Tag="120" Click="SaveChip_Click" Content="2 мин" />
                                    <Button x:Name="FullChip" Style="{StaticResource Gfe.Chip}" Margin="3,0" Tag="0" Click="SaveChip_Click" Content="Всё" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ЗВУК" Style="{StaticResource Gfe.SectionTitle}" />
                        <Border Background="{StaticResource Gfe.Tile}" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Gfe.Line}" Padding="0,6">
                            <ContentControl x:Name="AudioHost" Focusable="False" />
                        </Border>

                        <TextBlock Text="ПОСЛЕДНИЕ КЛИПЫ" Style="{StaticResource Gfe.SectionTitle}" />
                        <Border Background="{StaticResource Gfe.Tile}" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Gfe.Line}" Padding="0,6">
                            <ContentControl x:Name="GalleryHost" Focusable="False" />
                        </Border>

                        <TextBlock Text="СКРИНШОТЫ" Style="{StaticResource Gfe.SectionTitle}" />
                        <Border Background="{StaticResource Gfe.Tile}" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Gfe.Line}" Padding="0,6">
                            <ContentControl x:Name="ShotsHost" Focusable="False" />
                        </Border>

                        <Expander x:Name="PerfExpander" Margin="0,14,0,0" Expanded="PerfExpander_Changed" Collapsed="PerfExpander_Changed"
                                  Foreground="{StaticResource CB.TextSecondary}">
                            <Expander.Header>
                                <TextBlock Text="ПРОИЗВОДИТЕЛЬНОСТЬ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CB.TextTertiary}" />
                            </Expander.Header>
                            <Border Background="{StaticResource Gfe.Tile}" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Gfe.Line}"
                                    Padding="0,6" Margin="0,8,0,0">
                                <ContentControl x:Name="PerfHost" Focusable="False" />
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border x:Name="ContentCard" Grid.Column="1" Margin="28" Visibility="Collapsed"
                Background="#FF1B1B1B" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Gfe.Line}"
                ClipToBounds="True">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="52" Background="#FF202020">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="BackButton" Style="{StaticResource Ov.BarButton}" ToolTip="Назад к галерее" Click="Back_Click" Visibility="Collapsed">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" />
                        </Button>
                        <TextBlock x:Name="ContentTitle" Text="Галерея" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource CB.TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource Ov.BarButton}" HorizontalAlignment="Right" Margin="0,0,10,0" ToolTip="Закрыть"
                            Click="CloseContent_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                    </Button>
                </Grid>
                <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Focusable="False" JournalOwnership="OwnsJournal" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
