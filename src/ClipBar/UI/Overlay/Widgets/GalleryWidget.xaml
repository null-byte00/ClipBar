<UserControl x:Class="ClipBar.UI.Overlay.Widgets.GalleryWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ClipBar.UI.Overlay.Widgets"
             Width="384" Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI/Overlay/OverlayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="12,0,12,8">
        <ItemsControl x:Name="Tiles">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:GalleryTile}">
                    <Button Style="{StaticResource Ov.TileButton}" Click="Tile_Click" ToolTip="{Binding Tooltip}" HorizontalAlignment="Left">
                        <StackPanel Width="112">
                            <Border Height="63" CornerRadius="{StaticResource CB.Radius.Control}" Background="{StaticResource Ov.Tile}">
                                <Grid>
                                    <Border CornerRadius="{StaticResource CB.Radius.Control}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <ui:SymbolIcon Symbol="Video24" FontSize="22" Foreground="{StaticResource CB.TextTertiary}"
                                                   Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}" />
                                    <Border Background="{StaticResource Ov.Badge}" CornerRadius="3" Padding="4,1" Margin="0,0,4,4"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Camera16" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsScreenshot, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CB.Text.Caption}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="2,5,2,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Margin="4,10,4,10">
            <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="28" Foreground="{StaticResource CB.TextTertiary}" HorizontalAlignment="Left" />
            <TextBlock x:Name="EmptyTitle" Text="Пока нет записей" Style="{StaticResource CB.Text.Body}" Margin="0,8,0,0" />
            <TextBlock x:Name="EmptyHint" Style="{StaticResource CB.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Сохрани откат или сделай скриншот — они появятся здесь." />
        </StackPanel>

        <Border Height="1" Background="{StaticResource CB.Divider}" Margin="0,8,0,2" />
        <Button Style="{StaticResource CB.RowButton}" HorizontalContentAlignment="Stretch" Margin="-4,0,-4,0" Padding="8,8" Click="OpenGallery_Click">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ImageMultiple20" FontSize="16" Foreground="{StaticResource CB.TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Text="Открыть коллекцию" Style="{StaticResource CB.Text.Body}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ui:SymbolIcon Symbol="ChevronRight16" FontSize="12" Foreground="{StaticResource CB.TextTertiary}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>
