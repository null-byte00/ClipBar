<UserControl x:Class="ClipBar.UI.Overlay.ScreenshotViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" KeyDown="Viewer_KeyDown">
    <UserControl.Resources>
        <Style x:Key="Sv.Nav" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#99000000" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#FF0B0B0B" CornerRadius="8" BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="8" />
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#FFB3B3B3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button x:Name="PrevButton" Style="{StaticResource Sv.Nav}" HorizontalAlignment="Left" Margin="12,0,0,0" ToolTip="Предыдущий (←)" Click="Prev_Click">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="20" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource Sv.Nav}" HorizontalAlignment="Right" Margin="0,0,12,0" ToolTip="Следующий (→)" Click="Next_Click">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="20" />
                </Button>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Background="#B3000000" CornerRadius="4" Padding="8,3">
                    <TextBlock x:Name="CounterText" Foreground="White" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource CB.TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="560" HorizontalAlignment="Left" />
                <TextBlock x:Name="MetaText" FontSize="12" Foreground="{StaticResource CB.TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Копировать" Icon="{ui:SymbolIcon Copy20}" Appearance="Secondary" Margin="0,0,8,0" ToolTip="В буфер обмена (Ctrl+C)" Click="Copy_Click" />
                <ui:Button Content="Показать в папке" Icon="{ui:SymbolIcon FolderOpen20}" Appearance="Secondary" Margin="0,0,8,0" Click="Folder_Click" />
                <ui:Button Content="Открыть" Icon="{ui:SymbolIcon Open20}" Appearance="Secondary" Margin="0,0,8,0" ToolTip="В программе просмотра Windows" Click="OpenExternal_Click" />
                <ui:Button Content="Удалить" Icon="{ui:SymbolIcon Delete20}" Appearance="Secondary" Foreground="{StaticResource CB.Error}" ToolTip="В корзину (Delete)" Click="Delete_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
