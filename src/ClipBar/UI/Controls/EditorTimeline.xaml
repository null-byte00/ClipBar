<UserControl x:Class="ClipBar.UI.Controls.EditorTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" MinHeight="128" Background="Transparent"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="Handle" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Background" Value="{StaticResource CB.Accent}" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7ED4FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Grip" TargetType="Rectangle">
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="16" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
            <Setter Property="Fill" Value="#FF10233A" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent" Margin="14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Canvas x:Name="RulerCanvas" Grid.Row="0" ClipToBounds="True" Background="Transparent" />

        <Grid x:Name="TrackArea" Grid.Row="2" Height="98">
            <Border x:Name="TrackFrame" CornerRadius="6" Background="#FF181818" BorderBrush="{StaticResource CB.Divider}"
                    BorderThickness="1" ClipToBounds="True">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FF141414" />
                    <Image x:Name="FilmstripImage" Grid.Row="0" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="FilmstripHint" Grid.Row="0" Text="Готовим ленту кадров…" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource CB.TextTertiary}" />
                    <Border Grid.Row="1" Background="#FF101010" />
                    <Border Grid.Row="2" Background="#FF1C1C1C" />
                    <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Center" Fill="#22FFFFFF" />
                    <Image x:Name="WaveformImage" Grid.Row="2" Stretch="Fill" Opacity="0.95" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="WaveformHint" Grid.Row="2" Text="Без звука" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource CB.TextTertiary}" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Canvas x:Name="Overlay" ClipToBounds="False">
                <Rectangle x:Name="DimLeft" Fill="#B3121212" IsHitTestVisible="False" />
                <Rectangle x:Name="DimRight" Fill="#B3121212" IsHitTestVisible="False" />
                <Rectangle x:Name="RangeTop" Height="3" Fill="{StaticResource CB.Accent}" IsHitTestVisible="False" />
                <Rectangle x:Name="RangeBottom" Height="3" Fill="{StaticResource CB.Accent}" IsHitTestVisible="False" />
                <Border x:Name="HandleIn" Style="{StaticResource Handle}" CornerRadius="6,0,0,6">
                    <Rectangle Style="{StaticResource Grip}" />
                </Border>
                <Border x:Name="HandleOut" Style="{StaticResource Handle}" CornerRadius="0,6,6,0">
                    <Rectangle Style="{StaticResource Grip}" />
                </Border>
                <Rectangle x:Name="HoverLine" Width="1" Fill="#80FFFFFF" IsHitTestVisible="False" Visibility="Collapsed" />
            </Canvas>
        </Grid>

        <Canvas x:Name="PlayheadLayer" Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="False">
            <Rectangle x:Name="PlayheadLine" Width="2" Fill="White">
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="Black" />
                </Rectangle.Effect>
            </Rectangle>
            <Path x:Name="PlayheadHead" Fill="White" Data="M0,0 L12,0 L12,7 L6,13 L0,7 Z" Canvas.Top="4">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="Black" />
                </Path.Effect>
            </Path>
            <Border x:Name="HoverLabel" Background="#F0111111" BorderBrush="{StaticResource CB.WidgetBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="6,2" Visibility="Collapsed" Canvas.Top="-2">
                <TextBlock x:Name="HoverText" FontSize="11" Foreground="{StaticResource CB.TextPrimary}" FontFamily="Consolas, Segoe UI" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>
