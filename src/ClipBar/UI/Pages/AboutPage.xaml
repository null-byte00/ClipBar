<Page x:Class="ClipBar.UI.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:pages="clr-namespace:ClipBar.UI.Pages"
      Title="О программе"
      FontFamily="{StaticResource CB.Font}"
      Foreground="{StaticResource CB.TextPrimary}"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="Row" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,13,16,13" />
            <Setter Property="MinHeight" Value="66" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource CB.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource CB.Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CB.TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource CB.Control}" />
            <Setter Property="BorderBrush" Value="{StaticResource CB.WidgetBorder}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource CB.Radius.Small}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CB.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CB.ControlPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="36,12,24,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel>

                <TextBlock Style="{StaticResource CB.Text.Big}" Text="О программе" Margin="0,12,0,4" />

                <Border Background="{StaticResource CB.Card}" BorderBrush="{StaticResource CB.Divider}" BorderThickness="1" CornerRadius="8" Padding="16,16" Margin="0,14,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource CB.Record}" VerticalAlignment="Center" Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="Record24" Filled="True" FontSize="26" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CB.Text.Big}" FontSize="20" Text="ClipBar" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource CB.Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Версия 1.0.0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CB.Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Запись экрана и мгновенный откат для Windows." />
                            <TextBlock Style="{StaticResource CB.Text.Body}" Margin="0,6,0,0">
                                <Hyperlink NavigateUri="https://github.com/null-byte00" RequestNavigate="OnGithubClick"
                                           Foreground="#FFFF6B7A" TextDecorations="None">
                                    <Run Text="github.com/null-byte00" FontWeight="SemiBold" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowSync24}">
                    <ui:CardControl.Header>
                        <pages:SettingsRowHeader Title="Обновления" Description="Новые версии скачиваются с GitHub и ставятся при запуске" />
                    </ui:CardControl.Header>
                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource FlatButton}" Click="OnCheckUpdatesClick" Content="Проверить сейчас" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Code24}">
                    <ui:CardControl.Header>
                        <pages:SettingsRowHeader x:Name="FfmpegHeader" Title="FFmpeg" Description="Определяю версию…" />
                    </ui:CardControl.Header>
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon DeveloperBoard24}">
                    <ui:CardControl.Header>
                        <pages:SettingsRowHeader x:Name="GpuHeader" Title="Видеокарта" Description="…" />
                    </ui:CardControl.Header>
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon DocumentText24}">
                    <ui:CardControl.Header>
                        <pages:SettingsRowHeader Title="Журнал" Description="В логах есть причина, если что-то пошло не так" />
                    </ui:CardControl.Header>
                    <Button x:Name="OpenLogsButton" Style="{StaticResource FlatButton}" Click="OnOpenLogsClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Открыть папку логов" />
                        </StackPanel>
                    </Button>
                </ui:CardControl>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
